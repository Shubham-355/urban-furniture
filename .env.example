# ---- Database ----
DATABASE_URL="postgresql://urban:urban@localhost:5432/urbanfurniture?schema=public"

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-in-production-urban-furniture
JWT_EXPIRES_IN=12h
PASSWORD_RESET_TTL_MINUTES=30

# ---- SMTP ----
# Gmail needs 2FA switched on and a 16 character App Password (paste it
# without the spaces Google shows). Leave USER and PASS blank to skip sending:
# the app then logs each message and says so instead of failing silently.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Gmail rejects a From address it does not own - use the SMTP_USER address.
MAIL_FROM="Urban Furniture <you@gmail.com>"

# ---- Uploads ----
UPLOAD_DIR=uploads
